# 민감 문서 (사업계획서 등) - 공개 저장소에 올리지 않음
docs/

# Node
node_modules/
web/dist/

# Python
__pycache__/
*.pyc
.venv/

# 로컬 산출물
collector/.cache/
*.log
*.log.*
*.har
.wrangler/
test-results/
playwright-report/
blob-report/

# 정확 주소·좌표가 포함될 수 있는 수집 데이터/로컬 백업
